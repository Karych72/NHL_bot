# Secret Manager -> /run/nhl_bot и /run/nhl_bot_dev (tmpfs) при загрузке VM, до старта
# контейнеров (Задачи 65, 80). Установка — DEVELOPMENT.md §«Прод-деплой», «Токен бота».
[Unit]
Description=NHL_bot: токены прод- и dev-бота из Secret Manager в /run
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Каждый стек — скриптом из своего чекаута: dev-ветка не меняет то, чем прод получает токен.
# Прод первым: сбой dev-секрета роняет юнит, но токен прода к этому моменту уже записан.
ExecStart=/opt/nhl_bot/deploy/fetch-secrets.sh nhl-bot-telegram-token /run/nhl_bot
ExecStart=/opt/nhl_bot_dev/deploy/fetch-secrets.sh nhl-bot-telegram-token-dev /run/nhl_bot_dev
# metadata-сервер в первые секунды после загрузки может не ответить.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

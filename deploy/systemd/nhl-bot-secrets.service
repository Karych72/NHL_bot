# Secret Manager -> /run/nhl_bot (tmpfs) при загрузке VM, до старта контейнеров (Задача 65).
# Установка — DEVELOPMENT.md §«Прод-деплой», «Токен бота».
[Unit]
Description=NHL_bot: токен бота из Secret Manager в /run/nhl_bot
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/nhl_bot/deploy/fetch-secrets.sh
# metadata-сервер в первые секунды после загрузки может не ответить.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

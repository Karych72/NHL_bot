# Secret Manager -> /run/nhl_bot и /run/nhl_bot_dev (tmpfs) при загрузке VM, до старта
# контейнеров (Задачи 65, 80, 81). Установка — DEVELOPMENT.md §«Прод-деплой», «Токен бота».
# Ключ Claude API — в подкаталог anthropic/: скрипт чекаута старше Задачи 81 положит туда
# безвредный telegram_bot_token, а не перезапишет токен бота.
[Unit]
Description=NHL_bot: токены прод- и dev-бота и ключ Claude API из Secret Manager в /run
Wants=network-online.target
After=network-online.target
Before=docker.service
# Ретраи конечны: oneshot в auto-restart держит docker.service (Before=), и бесконечные
# ретраи из-за сломанной dev-половины (нет чекаута, секрета, доступа) не дали бы подняться
# и проду. 5 попыток за ~минуту — юнит падает, docker стартует, прод работает, а dev-
# контейнеры громко падают на отсутствующем файле токена.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
# Каждый стек — скриптом из своего чекаута: dev-ветка не меняет то, чем прод получает токен.
# Прод первым: сбой dev-половины роняет юнит, но токен прода к этому моменту уже записан.
ExecStart=/opt/nhl_bot/deploy/fetch-secrets.sh nhl-bot-telegram-token /run/nhl_bot
ExecStart=/opt/nhl_bot/deploy/fetch-secrets.sh nhl-bot-anthropic-key /run/nhl_bot/anthropic anthropic_api_key
ExecStart=/opt/nhl_bot_dev/deploy/fetch-secrets.sh nhl-bot-telegram-token-dev /run/nhl_bot_dev
ExecStart=/opt/nhl_bot_dev/deploy/fetch-secrets.sh nhl-bot-anthropic-key /run/nhl_bot_dev/anthropic anthropic_api_key
# metadata-сервер в первые секунды после загрузки может не ответить.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

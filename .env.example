TELEGRAM_BOT_TOKEN=

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_DATABASE=postgres

# Обязательно для сервиса backup (docker-compose.yml, Задача 35): путь на хосте вне
# репозитория и вне тома pgdata, куда пишутся суточные дампы pg_dump. Только абсолютный
# путь, например /Users/<you>/nhl_bot_backups — не "~/...": docker compose раскрывает "~"
# в bind mount, но процедуры восстановления в DEVELOPMENT.md §Docker читают это значение
# в шелл хоста буквально (без раскрытия "~"), так что "~"-путь их сломает.
BACKUP_DIR=

# Optional for pipeline date range — без них лоадер берёт окно от даты
# старта SEASON_ID (config.derive_season(), Задача 33) до сегодня.
# DATE_FROM=2026-03-18
# DATE_TO=2026-03-18

# Обязательно: NHL seasonId — единственный источник сезона. Подпись сезона и
# дата старта make season-load-full выводятся из него (config.derive_season()).
SEASON_ID=

# Опционально: рассылка push_digest_job.py (см. docs/telegram_bot.md §7)
# ENABLE_PUSH_DIGEST=0
# PUSH_SEND_INTERVAL_SEC=0.05
